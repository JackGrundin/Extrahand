# Adressen till backend.
#
# Den här filen ÄR versionerad och ska ALLTID peka på produktion. Kör du mot en lokal
# backend: skapa frontend/.env.local med din egen rad i stället. Den filen är gitignorerad
# (.env*.local) och kan därför aldrig råka committas:
#
#   EXPO_PUBLIC_API_URL=http://localhost:3999/api
#
# Värdet innehåller /api. Alla anrop i src/api/klient.js börjar med / (/auth/logga-in,
# /jobb), så utan suffixet hamnar varje request på api.fastgig.se/auth/logga-in och ger 404.
EXPO_PUBLIC_API_URL=https://api.fastgig.se/api
